# Copie este arquivo para ".env" e ajuste os valores.

# String de conexão do PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/controle_financeiro?schema=public"

PORT=4000
NODE_ENV=development

# Origem permitida no CORS (URL do frontend)
CORS_ORIGIN="http://localhost:5173"

# Segredos dos tokens JWT (gere algo aleatório, ex: `openssl rand -hex 32`)
JWT_ACCESS_SECRET="troque-este-valor-por-um-segredo-forte"
JWT_REFRESH_SECRET="troque-este-outro-valor-tambem"

# Tempo de vida dos tokens
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30
